## VC8000D config
SUB_SYS_VCD                       ?= 1
S1_VCD_A                          ?= 1
S1_VCD_B                          ?= 1
S2_VCD_A                          ?= 1
S2_VCD_B                          ?= 1

## VC8000E config
SUB_SYS_VCE                       ?= 1
S1_VCE                            ?= 1
S2_VCE                            ?= 1
SKIP_VCE                          ?= 0 # for cutree only fpga image

## for VC8000D and VC8000E
VCMD_ENABLE_VC8000D               ?= 1
VCMD_ENABLE_VC8000E               ?= 0

## Xilinx ABR config
SUB_SYS_XABR                      ?= 1

## Xilinx AV1 config
SUB_SYS_XAV1                      ?= 1

## RISCV config
SUB_SYS_RISCV                     ?= 0
SYS_RISCV_0                       ?= 0
SYS_RISCV_1                       ?= 0

TRACE_OSAL                        ?= 0
TRACE_OSAL_MEMORY                 ?= 0

TRACE_PERF                        ?= 0
TRACE_XAV1_ENC                    ?= 0
TRACE_DMA_BUF                     ?= 0

##############################################################
#  some environment setting for vivante internal

ARCH_TYPE                         ?= arm
SDK_DIR                           ?= $(AQROOT)/build/sdk
SOC_PLATFORM                      ?= amd-supernova
NO_DMA_COHERENT                   ?= 1
USE_LINUX_PCIE                    ?= 1
USE_PCIE_CONFIG                   ?= 1
USE_HDMA_CONFIG                   ?= 1
DEBUG                             ?= 0
