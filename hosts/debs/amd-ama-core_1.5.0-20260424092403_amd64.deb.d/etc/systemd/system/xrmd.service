[Unit]
Description=Xilinx Resource Manager Daemon
Wants=network-online.target
After=network-online.target
#ConditionDirectoryNotEmpty=/dev/xfpga

[Service]
Type=simple
LimitNOFILE=1000000
#Environment="LD_LIBRARY_PATH=/opt/xilinx/xrt/lib"
Environment="LD_LIBRARY_PATH=/opt/amd/ma35/lib/"
Restart=always
RestartSec=1
ExecStart=/opt/amd/ama/ma35/scripts/.xrmd_start.sh

[Install]
WantedBy=multi-user.target
